# Local Docker only. Docker Compose reads the ignored root .env file.
CATCHUP_POSTGRES_DB=catchup
CATCHUP_POSTGRES_USER=postgres
CATCHUP_POSTGRES_PASSWORD=
CATCHUP_TEST_POSTGRES_DB=catchup_test
CATCHUP_TEST_POSTGRES_USER=catchup_test
CATCHUP_TEST_POSTGRES_PASSWORD=
CATCHUP_PGADMIN_EMAIL=admin@example.com
CATCHUP_PGADMIN_PASSWORD=
# API reverse-proxy hops controlled by the deployment (0-10).
TRUST_PROXY_HOPS=0
