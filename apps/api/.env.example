# Database / Prisma. Use the same local URL for both during development.
# Staging: DATABASE_URL uses Supavisor transaction mode (port 6543).
# Staging: DIRECT_URL uses session mode or the direct endpoint (port 5432).
DATABASE_URL=""
DIRECT_URL=""

# API
NODE_ENV="development"
JWT_SECRET=""
PORT=3001
WEB_ORIGIN="http://localhost:3000"
# Number of reverse-proxy hops controlled by the deployment (0-10).
TRUST_PROXY_HOPS=0

# Local development seed only. Do not configure these in production.
CATCHUP_SEED_ADMIN_EMAIL="admin@example.com"
CATCHUP_SEED_ADMIN_PASSWORD=""
CATCHUP_SEED_KAZUMA_PASSWORD=""
