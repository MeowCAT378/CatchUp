generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HOST
  PLAYER
}
enum RoomStatus {
  LOBBY
  ACTIVE
  FINISHED
}
enum RoomPhase {
  WAITING
  ACTIVE
  REVEALED
  COMPLETED
}
enum ActivityType {
  QUIZ
  POLL
  WORD_CLOUD
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  role Role @default(HOST)
  isDisabled Boolean @default(false)
  quizzes Quiz[] @relation("QuizOwner")
  hostedRooms Room[] @relation("RoomHost")
  adminAuditLogs AdminAuditLog[] @relation("AuditAdmin")
  targetedAuditLogs AdminAuditLog[] @relation("AuditTarget")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Quiz {
  id String @id @default(cuid())
  title String
  description String?
  type ActivityType @default(QUIZ)
  ownerId String
  owner User @relation("QuizOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  questions Question[]
  rooms Room[]
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, deletedAt])
}
model Question {
  id String @id @default(cuid())
  quizId String
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text String
  position Int
  choices Choice[]
  answers Answer[]
  wordCloudEntries WordCloudEntry[]
  @@unique([quizId, position])
}
model Choice {
  id String @id @default(cuid())
  questionId String
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text String
  isCorrect Boolean @default(false)
  answers Answer[]
}
model Room {
  id String @id @default(cuid())
  code String @unique
  quizId String
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  hostId String
  host User @relation("RoomHost", fields: [hostId], references: [id], onDelete: Restrict)
  activityTitle String
  activityType ActivityType
  status RoomStatus @default(LOBBY)
  phase RoomPhase @default(WAITING)
  currentQuestionIndex Int @default(0)
  participants Participant[]
  attempts QuizAttempt[]
  wordCloudEntries WordCloudEntry[]
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@index([hostId, status, createdAt])
  @@index([activityType, startedAt])
  @@index([status, endedAt])
}
model Participant {
  id String @id @default(cuid())
  accessToken String @unique @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  displayName String
  attempts QuizAttempt[]
  wordCloudEntries WordCloudEntry[]
  wordCloudVotes WordCloudVote[]
  joinedAt DateTime @default(now())
  @@unique([roomId, displayName])
}
model QuizAttempt {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId String
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  score Int @default(0)
  finishedAt DateTime?
  answers Answer[]
  @@unique([roomId, participantId])
  @@index([roomId, score])
}
model Answer {
  id String @id @default(cuid())
  attemptId String
  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choiceId String
  choice Choice @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  isCorrect Boolean
  submittedAt DateTime @default(now())
  @@unique([attemptId, questionId])
}
model WordCloudEntry {
  id String @id @default(cuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  questionId String
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// Legacy rows may be null because their creator was not recorded; new writes always set this.
  participantId String?
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  text String
  normalizedText String
  votes WordCloudVote[]
  createdAt DateTime @default(now())
  @@unique([roomId, questionId, normalizedText])
  @@unique([roomId, questionId, participantId])
  @@index([roomId, questionId])
  @@index([participantId])
}
model WordCloudVote {
  id String @id @default(cuid())
  entryId String
  entry WordCloudEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  participantId String
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([participantId, entryId])
  @@index([entryId])
}

model AdminAuditLog {
  id String @id @default(cuid())
  adminId String
  admin User @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  targetUserId String
  targetUser User @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  action String
  createdAt DateTime @default(now())
  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
}
